<?xml version="1.0"?>
<ruleset name="Inblock Map Block">
	<description>WordPress Coding Standards for Inblock Map Block.</description>

	<file>inblock-map-block.php</file>
	<file>includes</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="inblock-map-block"/>
			</property>
		</properties>
	</rule>
	<!-- Freemius requires the __premium_only suffix to strip paid code from free builds. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>includes/pro__premium_only.php</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
